{
  "name": "vocafy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secretlint": "secretlint --maskSecrets '**/*'",
    "typecheck": "next typegen && tsc --noEmit",
    "lefthook:install": "lefthook install",
    "test": "vitest run",
    "knip": "knip",
    "test:e2e": "playwright test",
    "lighthouse": "pnpm build && lhci autorun",
    "db:up": "docker compose up -d --wait",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-virtual": "^3.14.13",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.7.7",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-ios-pwa-prompt": "^2.0.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "use-pwa": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "schema-dts": "^2.1.0",
    "secretlint": "^13.0.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.1.2"
}
