{
  "name": "vocafy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secretlint": "secretlint --maskSecrets '**/*'",
    "typecheck": "next typegen && tsc --noEmit",
    "lefthook:install": "lefthook install",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "knip": "knip",
    "test:e2e": "playwright test",
    "voice-themes": "tsx scripts/voice-themes.ts",
    "song-names": "tsx --env-file-if-exists=.env.local scripts/song-names.ts",
    "voice-names": "tsx --env-file-if-exists=.env.local scripts/voice-names.ts",
    "silhouettes": "tsx scripts/silhouettes.ts",
    "lighthouse": "pnpm build && lhci autorun",
    "db:up": "docker compose up -d --wait",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@sentry/nextjs": "^11.6.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-virtual": "^3.14.13",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.7.7",
    "next": "16.3.8",
    "niconico-embed-player": "0.1.2",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-ios-pwa-prompt": "^2.0.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "uqr": "0.1.3",
    "use-pwa": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.15.1",
    "@piro0919/eslint-config": "github:piro0919/eslint-config#v1.1.0",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-hollow-tests": "0.3.0",
    "happy-dom": "^20.14.6",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "schema-dts": "^2.1.0",
    "secretlint": "^13.1.0",
    "sharp": "0.35.5",
    "squawk-cli": "2.70.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.1.2"
}
